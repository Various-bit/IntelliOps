# Скопируй в .env и поправь. Относительные пути считаются от папки, где лежит .env.
DATA_DIR=data/raw
CORPUS_DIR=data/corpus
CHROMA_DIR=data/chroma
EVAL_CASES_DIR=eval/cases

# БД с рядами (TimescaleDB/PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/intelliops

# LLM (только через get_llm(role); модель и бюджет см. docs/decisions.md)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_BUDGET_USD=1.0

# LangSmith (трассы), необязательно
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intelliops
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
